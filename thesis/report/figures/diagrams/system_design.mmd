    classDef planned fill:#F1F3F5,color:#475569,stroke:#5B6472,stroke-dasharray:4 2;
    classDef tool fill:#ECEFF2,color:#0E1116,stroke:#5B6472;
    class WHD,CUS planned;
    class LOAD,DEMO tool;
    class NGINX,BE,Client data

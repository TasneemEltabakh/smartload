flowchart TB
    OTel["<b>OTel Collector</b> → <b>Telemetry Service</b>"]
    metrics[("<b>metrics</b><br/>raw hypertable<br/>retention 7 d")]
    OTel ==>|"METRICS_INSERT"| metrics

    metrics_1min[("<b>metrics_1min</b><br/>continuous aggregate<br/>retention 30 d")]
    AND["<b>Anomaly Detector</b><br/>5 s cycle"]
    ASL["<b>Autoscaler</b><br/>event-driven on<br/>smartload.forecast (Redis)"]

    metrics -.->|"materialised every 1 min"| metrics_1min
    metrics -->|"ANOMALY_QUERY"| AND

    backend_health[("<b>backend_health</b><br/>hypertable<br/>retention 30 d")]
    scaling_events[("<b>scaling_events</b><br/>hypertable<br/>retention 90 d")]
    policy_changes[("<b>policy_changes</b><br/>hypertable<br/>retention 90 d")]
    forecasts[("<b>forecasts</b><br/>hypertable<br/>retention 30 d<br/>v1.0.7w #159")]

    AND ==>|"BACKEND_HEALTH_INSERT"| backend_health
    ASL ==>|"SCALING_EVENT_INSERT"| scaling_events
    PM["<b>Policy Manager</b><br/>on POST"] ==>|"POLICY_CHANGE_INSERT"| policy_changes

    FCT["Forecasting Engine"]
    GRF["Grafana / Queries"]
    RL["RL Engine"]
    SC["LB Sidecar"]

    metrics -->|"FORECAST_QUERY"| FCT
    metrics_1min --> FCT
    metrics_1min --> GRF
    metrics -->|"RL_STATE_QUERY"| RL
    metrics --> GRF
    backend_health -->|"BACKEND_HEALTH_QUERY"| RL
    backend_health --> SC
    backend_health --> GRF
    scaling_events --> GRF
    policy_changes --> GRF
    FCT ==>|"FORECAST_INSERT"| forecasts
    forecasts --> GRF


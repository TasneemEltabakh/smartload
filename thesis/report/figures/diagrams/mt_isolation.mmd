flowchart TB
    subgraph Request["Request plane"]
        API[/"/api/v1/policy<br/>X-API-Key: sl_xyz"/]
        KEY[("api_keys<br/>key_id → tenant_id<br/>+ scopes")]
        AUTHZ{"Auth middleware<br/>resolve tenant_id<br/>+ check scope"}
        API --> AUTHZ
        KEY -.lookup.-> AUTHZ
    end

    subgraph Storage["Storage plane (tenant-scoped writes)"]
        PYAML[("config/tenants/&lt;tenant_id&gt;<br/>policy.yaml")]
        PCH[("policy_changes<br/>tenant_id NOT NULL")]
        MET[("metrics<br/>tenant_id NOT NULL")]
        SCE[("scaling_events<br/>tenant_id NOT NULL")]
    end

    subgraph Bus["Redis pub/sub"]
        CHA[("t:&lt;tenant_id&gt;:<br/>smartload.policy")]
        CHB[("t:&lt;tenant_id&gt;:<br/>smartload.anomaly")]
        CHC[("t:&lt;tenant_id&gt;:<br/>smartload.forecast")]
    end

    AUTHZ ==>|"writes scoped"| PYAML
    AUTHZ ==>|"audit row"| PCH
    AUTHZ ==>|"publish scoped"| CHA

    SUB["Subscriber<br/>(per-tenant)"] -.filter on tenant_id.-> CHA
    SUB -.filter.-> CHB
    SUB -.filter.-> CHC

    classDef tenant fill:#EFF3F6,color:#0f172a,stroke:#5B6472;
    classDef auth   fill:#F1F3F5,color:#0f172a,stroke:#5B6472;
    classDef bus    fill:#DCE7EE,color:#0f172a,stroke:#5B6472;
    classDef store  fill:#DCEFE4,color:#0f172a,stroke:#2E8B57;
    class API,SUB tenant
    class AUTHZ,KEY auth
    class CHA,CHB,CHC bus
    class PYAML,PCH,MET,SCE store

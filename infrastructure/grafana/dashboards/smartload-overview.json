      "title": "Request rate (req/s)",
      "type": "timeseries",
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  time_bucket('$__interval', time) AS \"time\",\n  count(*)::float * 1000.0 / $__interval_ms AS \"req/s\"\nFROM metrics\nWHERE $__timeFilter(time)\n  AND metric_name = 'request_count'\nGROUP BY 1\nORDER BY 1",
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "timescaledb"}
        }
      ]

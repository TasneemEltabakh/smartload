      "title": "Request latency — p50 / p95 / max",
      "type": "timeseries",
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  time_bucket('$__interval', time) AS \"time\",\n  percentile_disc(0.50) WITHIN GROUP (ORDER BY value) AS p50,\n  percentile_disc(0.95) WITHIN GROUP (ORDER BY value) AS p95,\n  max(value) AS max\nFROM metrics\nWHERE $__timeFilter(time)\n  AND metric_name = 'request_latency_ms'\nGROUP BY 1\nORDER BY 1",
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "timescaledb"}
        }
      ]

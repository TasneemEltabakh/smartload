            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {"group": "A", "mode": "none"},
            "thresholdsStyle": {"mode": "line"}
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 200}
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 9},
      "id": 2,
      "options": {
        "legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "title": "p95 latency per backend (SLO line at 200 ms)",
      "type": "timeseries",
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  time_bucket('$__interval', time) AS \"time\",\n  instance AS metric,\n  percentile_cont(0.95) WITHIN GROUP (ORDER BY value) AS value\nFROM metrics\nWHERE $__timeFilter(time)\n  AND service = 'load-balancer'\n  AND metric_name = 'request_latency_ms'\nGROUP BY 1, 2\nORDER BY 1",
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "timescaledb"}
        }
      ]
    },
    {
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "timescaledb"},

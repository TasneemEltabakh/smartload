            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {"group": "A", "mode": "none"},
            "thresholdsStyle": {"mode": "off"}
          },
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 17},
      "id": 4,
      "options": {
        "legend": {"calcs": ["mean", "max"], "displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "title": "Total throughput (req/s)",
      "type": "timeseries",
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  time_bucket('$__interval', time) AS \"time\",\n  SUM(value) / EXTRACT(EPOCH FROM '$__interval'::interval) AS rps\nFROM metrics\nWHERE $__timeFilter(time)\n  AND service = 'load-balancer'\n  AND metric_name = 'request_count'\nGROUP BY 1\nORDER BY 1",
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "timescaledb"}
        }
      ]
    },
    {
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "timescaledb"},
      "description": "Per-backend request count over the last minute. Sort descending and the top row is the backend RL is currently routing the dominant share to — this is the closest persistent equivalent of `cat upstream.conf` you can get out of TimescaleDB.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "custom": {
            "align": "auto",
            "cellOptions": {"type": "auto"},
            "inspect": false
          },
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "share"},
            "properties": [
              {"id": "unit", "value": "percentunit"},
              {"id": "custom.cellOptions", "value": {"type": "color-background", "mode": "gradient"}},
              {"id": "color", "value": {"mode": "continuous-GrYlRd"}}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "avg_latency_ms"},
            "properties": [
              {"id": "unit", "value": "ms"}
            ]
          }
        ]
      },
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 17},
      "id": 5,
      "options": {
        "cellHeight": "sm",
        "footer": {"countRows": false, "fields": "", "reducer": ["sum"], "show": false},
        "showHeader": true,
        "sortBy": [{"desc": true, "displayName": "requests"}]
      },
      "title": "Backend leaderboard (last 1 min)",
      "type": "table",
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH window AS (\n  SELECT instance,\n         SUM(value) FILTER (WHERE metric_name = 'request_count')        AS requests,\n         AVG(value) FILTER (WHERE metric_name = 'request_latency_ms')   AS avg_latency_ms,\n         AVG(value) FILTER (WHERE metric_name = 'error_rate')           AS error_rate\n  FROM metrics\n  WHERE service = 'load-balancer'\n    AND time > NOW() - INTERVAL '1 minute'\n  GROUP BY instance\n),\ntotals AS (SELECT SUM(requests) AS total FROM window)\nSELECT instance,\n       requests,\n       CASE WHEN totals.total > 0 THEN requests / totals.total ELSE 0 END AS share,\n       avg_latency_ms,\n       error_rate\nFROM window, totals\nORDER BY requests DESC NULLS LAST",
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "timescaledb"}
        }
      ]
    }

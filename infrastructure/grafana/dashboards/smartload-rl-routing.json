    {
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "timescaledb"},
      "description": "Aggregate throughput across all backends. Used as context for the share/latency panels: if total RPS is low the per-backend distribution is noisy; if total RPS is high the share panel reflects steady-state RL behaviour.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",

          {
            "matcher": {"id": "byName", "options": "action"},
            "properties": [
              {"id": "mappings", "value": [{"type": "value", "options": {"scale_out": {"color": "orange"}, "scale_in": {"color": "blue"}}}]},
              {"id": "custom.cellOptions", "value": {"type": "color-text"}}
            ]
          }
        ]
      },
      "gridPos": {"h": 5, "w": 16, "x": 8, "y": 17},
      "id": 5,
      "options": {
        "cellHeight": "sm",
        "footer": {"countRows": false, "fields": "", "reducer": ["sum"], "show": false},
        "showHeader": true,
        "sortBy": [{"desc": true, "displayName": "time"}]
      },
      "title": "Recent scaling decisions (last 20)",
      "type": "table",
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT time, action, instance_count, reason\nFROM scaling_events\nORDER BY time DESC\nLIMIT 20",
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "timescaledb"}
        }
      ]
    }
  ],

# SmartLoad — Environment Variable Template
# Copy this file to .env at the repo root and fill in values.
# The .env file is gitignored and must never be committed.

# --- TimescaleDB ---
TIMESCALEDB_PASSWORD=changeme
TIMESCALEDB_URL=postgresql://postgres:changeme@timescaledb:5432/smartloaddb

# --- Redis (control bus) ---
REDIS_URL=redis://redis:6379

# --- OpenTelemetry Collector ---
OTEL_ENDPOINT=http://otel-collector:4318

# --- Grafana ---
GRAFANA_PASSWORD=admin

# --- Autoscaler limits ---
MIN_BACKENDS=1
MAX_BACKENDS=5

# --- Service tuning ---
POLL_INTERVAL_SECONDS=5
FORECAST_HORIZON_MINUTES=5

# --- RL Engine mode: shadow | active ---
RL_MODE=shadow

# --- Policy Manager ---
CONFIG_PATH=/config/policy.yaml

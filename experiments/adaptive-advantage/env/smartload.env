# SmartLoad-mode environment: full decision plane on, sidecar active.
#
# Every AI service runloop is on, the lb-sidecar consumes Redis signals and
# adjusts NGINX upstream weights, and the autoscaler reacts to forecasts.
# RL_MODE=active flips the rl-engine from "publish-only shadow" to actually
# influencing the LB sidecar's routing decisions.
#
# This is "the same stack with SmartLoad doing what it claims to do."
# Compose-cycle for this profile:
#     docker compose --env-file experiments/baseline-vs-smartload/env/smartload.env \
#         up -d --force-recreate <selected services>

ANOMALY_RUNLOOP_ENABLED=true
FORECAST_RUNLOOP_ENABLED=true
RL_RUNLOOP_ENABLED=true
LB_SIDECAR_RUNLOOP_ENABLED=true
RL_MODE=active

# Baseline-mode environment: plain NGINX round-robin, decision plane silent.
#
# The same docker-compose.yml + the same containers, but every decision-plane
# runloop is off, the lb-sidecar is off, and the load-balancer falls back to
# the static round-robin weights baked into services/load-balancer/nginx/nginx.conf.
# Anomaly + forecast + RL signal flows produce nothing; the autoscaler stays
# silent; the policy state is read-only background.
#
# This is "what the same stack does without SmartLoad's intelligence."
# Compose-cycle for this profile:
#     docker compose --env-file experiments/baseline-vs-smartload/env/baseline.env \
#         up -d --force-recreate <selected services>

ANOMALY_RUNLOOP_ENABLED=false
FORECAST_RUNLOOP_ENABLED=false
RL_RUNLOOP_ENABLED=false
LB_SIDECAR_RUNLOOP_ENABLED=false
RL_MODE=shadow
